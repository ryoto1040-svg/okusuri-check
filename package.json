{
  "name": "okusuri-check",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "test": "vitest run",
    "check:build": "node scripts/check-build.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared tests scripts *.json *.ts *.yaml docs README.md"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.0"
  }
}
